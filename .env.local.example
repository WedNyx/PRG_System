NEXT_PUBLIC_SUPABASE_URL=https://sua-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Somente no servidor (Vercel → Settings → Environment Variables). Nunca use NEXT_PUBLIC_ nestas.
# Senha de administrador para remover perfis no portal (“Gerenciar perfis”).
PRG_ADMIN_SENHA=troque-por-uma-senha-forte
# Opcional: busca de músicas no YouTube dentro da mesa.
YOUTUBE_API_KEY=sua-chave-da-api-do-youtube
